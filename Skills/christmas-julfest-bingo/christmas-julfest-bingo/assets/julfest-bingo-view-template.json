drawer-backdrop,.confetti{display:none!important}.layout{display:block}.board-panel{box-shadow:none;border:0;padding:0}.board{gap:4px}.square{min-height:78px;background:white!important;color:#111!important;border:1px solid #777!important}.square.marked:after{color:#111}.square.free{background:#eee!important}}\n</style></head><body><main class=\"app\"><header class=\"header\"><h1 id=\"title\">JulFest Bingo</h1><p>Markera orden när de ropas upp och gör anspråk på bingo när ett mönster är komplett.</p></header><div id=\"success\" class=\"success\" role=\"status\" aria-live=\"polite\"></div><button class=\"help-trigger\" id=\"helpOpen\" type=\"button\" aria-controls=\"helpPanel\" aria-expanded=\"false\">Så spelar du</button><div class=\"layout\"><section class=\"panel board-panel\" aria-label=\"Din bingobricka\"><div class=\"board-head\"><h2>Din bricka</h2><span class=\"count-badge\" id=\"markedCount\">0 / 24 markerade</span></div><div class=\"board\" id=\"board\" role=\"group\" aria-label=\"Bingobricka\"></div><div class=\"board-actions\"><button class=\"btn soft\" id=\"newRound\">Ny omgång</button><button class=\"btn red\" id=\"claim\" disabled>Ropa bingo</button><button class=\"btn soft\" id=\"print\">Skriv ut brickan</button></div><div class=\"status\" id=\"status\" aria-live=\"polite\"></div></section><aside class=\"sidebar\" aria-label=\"Spelkontroller\"><section class=\"panel latest\"><div class=\"kicker\">Senaste utrop</div><strong class=\"latest-word\" id=\"currentCall\">Inget ännu</strong><div class=\"latest-meta\" id=\"callCount\">0 ord ropade</div><div class=\"latest-actions\"><button class=\"btn soft\" id=\"draw\">Dra nästa ord</button><button class=\"btn soft\" id=\"undo\">Ångra senaste</button></div></section><section class=\"panel settings\"><h2 class=\"panel-title\">Spelinställningar</h2><div class=\"form-row\"><label for=\"role\">Roll</label><select id=\"role\"><option value=\"player\">Spelare</option><option value=\"caller\">Utropare</option></select>