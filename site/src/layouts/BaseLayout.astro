---
import { GitFork, Menu, Moon, Sun } from '@lucide/astro';
import '../styles/global.css';
import { sitePath } from '../lib/catalog';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'SharePoint Skills',
	description = 'Community-built skills for Microsoft 365 Copilot in SharePoint.',
	image = '/images/SharePoint_512.png',
} = Astro.props;
const pageTitle = title === 'SharePoint Skills' ? title : `${title} | SharePoint Skills`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(sitePath(image), Astro.site);
const currentPath = Astro.url.pathname;
const navigation = [
	{ label: 'Skills', href: '/' },
	{ label: 'Getting started', href: '/getting-started/' },
	{ label: 'Contributors', href: '/contributors/' },
	{ label: 'Contributing', href: '/contributing/' },
];
const isCurrent = (href: string) =>
	href === '/'
		? currentPath === sitePath('/') ||
			currentPath === sitePath('') ||
			currentPath.startsWith(sitePath('/skills/')) ||
			currentPath.startsWith(sitePath('/categories/')) ||
			currentPath.startsWith(sitePath('/whats-new/'))
		: currentPath.startsWith(sitePath(href));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta id="theme-color" name="theme-color" content="#f1f9f8" />
		<script is:inline>
			(() => {
				const storageKey = 'sharepoint-skills-theme';
				let storedTheme = null;
				try {
					storedTheme = localStorage.getItem(storageKey);
				} catch {}
				const theme = storedTheme === 'light' || storedTheme === 'dark'
					? storedTheme
					: 'light';
				document.documentElement.dataset.theme = theme;
				document.documentElement.style.colorScheme = theme;
			})();
		</script>
		<link rel="icon" href={sitePath('/images/SharePoint_512.png')} type="image/png" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<header class="site-header">
			<div class="spectrum" aria-hidden="true"></div>
			<div class="site-header__inner container">
				<a class="brand" href={sitePath('/')} aria-label="SharePoint Skills home">
					<img src={sitePath('/images/SharePoint_512.png')} alt="" width="38" height="38" />
					<span>SharePoint <strong>Skills</strong></span>
				</a>
				<div class="site-header__actions">
					<nav class="desktop-nav" aria-label="Primary navigation">
						{navigation.map((item) => (
							<a href={sitePath(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						))}
						<a class="nav-github" href="https://github.com/pnp/sharepoint-skills">
							<GitFork size={18} aria-hidden="true" /> GitHub
						</a>
					</nav>
					<button
						class="theme-toggle"
						id="theme-toggle"
						type="button"
						role="switch"
						aria-checked="false"
						aria-label="Switch to dark mode"
						title="Switch to dark mode"
					>
						<span class="theme-toggle__icons" aria-hidden="true">
							<Sun class="theme-toggle__sun" size={16} />
							<Moon class="theme-toggle__moon" size={15} />
						</span>
					</button>
					<details class="mobile-nav">
						<summary title="Open navigation" aria-label="Open navigation"><Menu size={22} /></summary>
						<nav aria-label="Mobile navigation">
							{navigation.map((item) => <a href={sitePath(item.href)}>{item.label}</a>)}
							<a href="https://github.com/pnp/sharepoint-skills">GitHub</a>
						</nav>
					</details>
				</div>
			</div>
		</header>
		<main id="main-content">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="container site-footer__inner">
				<div>
					<strong>Microsoft 365 & Power Platform Community</strong>
					<p>Sharing is caring. Built by the community, for the community.</p>
				</div>
				<nav aria-label="Footer navigation">
					<a href="https://aka.ms/community/home">Community home</a>
					<a href="https://aka.ms/community/samples">Community samples</a>
					<a href={sitePath('/whats-new/')}>What's new</a>
					<a href={sitePath('/categories/')}>Categories</a>
					<a href={sitePath('/catalog.json')}>Catalog JSON</a>
					<a href="https://github.com/pnp/sharepoint-skills/issues/new/choose">Report an issue</a>
					<a href="https://github.com/pnp/sharepoint-skills/security/policy">Security</a>
					<a href="https://github.com/pnp/sharepoint-skills/blob/main/CODE_OF_CONDUCT.md">Code of conduct</a>
					<a href="https://github.com/pnp/sharepoint-skills/blob/main/LICENSE">MIT license</a>
				</nav>
			</div>
		</footer>
		<script>
			const storageKey = 'sharepoint-skills-theme';
			const root = document.documentElement;
			const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
			const themeColor = document.querySelector<HTMLMetaElement>('#theme-color');

			function applyTheme(theme: 'light' | 'dark', persist = false) {
				root.dataset.theme = theme;
				root.style.colorScheme = theme;
				if (toggle) {
					const isDark = theme === 'dark';
					const label = `Switch to ${isDark ? 'light' : 'dark'} mode`;
					toggle.setAttribute('aria-checked', String(isDark));
					toggle.setAttribute('aria-label', label);
					toggle.title = label;
				}
				if (themeColor) themeColor.content = theme === 'dark' ? '#081715' : '#f1f9f8';
				if (persist) {
					try {
						localStorage.setItem(storageKey, theme);
					} catch {}
				}
			}

			applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');
			toggle?.addEventListener('click', () => {
				root.classList.add('theme-transition');
				applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark', true);
				window.setTimeout(() => root.classList.remove('theme-transition'), 420);
			});
		</script>
	</body>
</html>